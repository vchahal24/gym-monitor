# where the site gets its data
#   mock    everything simulated in the browser (default)
#   api     a full backend at VITE_API_URL (docs/DATA_CONTRACT.md §3)
#   hybrid  the real sensor nodes (LE01, LP01) from the bridge at VITE_API_URL, the rest simulated
#           (bridge/server.py, Bridge API v1 in docs/DATA_CONTRACT.md §4; `npm run dev:hybrid` sets this)
VITE_DATA_SOURCE=mock
# backend or bridge base URL, for a hosted site point it at the bridge's tunnel (see bridge/README.md)
VITE_API_URL=http://localhost:8000
